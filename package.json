{
  "name": "marching-band-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "scores": "node scripts/prepare-scores.mjs",
    "predev": "npm run scores",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run scores",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "ci:build": "npm test && npm run build",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "^0.35.5"
    }
  }
}
